# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# The password your father types on the login page.
APP_PASSWORD=
# Random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Optional: low | medium | high | xhigh | max (default: high)
ADVISOR_EFFORT=high
