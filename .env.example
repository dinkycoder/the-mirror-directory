# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# The secret code in the private link: https://your-site/?key=<ACCESS_KEY>
# Use something long and random, e.g. `openssl rand -hex 16`. Change it to revoke old links.
ACCESS_KEY=
# Random string used to sign the sign-in cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Optional: low | medium | high | xhigh | max (default: high)
ADVISOR_EFFORT=high
