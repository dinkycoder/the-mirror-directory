# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# The password the writer types on the sign-in page.
APP_PASSWORD=
# Random string used to sign the sign-in cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Optional: low | medium | high | xhigh | max (default: high)
ADVISOR_EFFORT=high
